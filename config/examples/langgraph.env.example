# Apply only after the e24b7c91d602 migration, in a reviewed deployment.
# Fixed, human-confirmed business graph. Does not enable autonomous model tools.
DP_AGENT_WORKFLOW_ENGINE=langgraph
DP_AGENT_GRAPH_LEASE_SECONDS=120
DP_AGENT_GRAPH_MAX_PENDING=20
DP_AGENT_TOOLS_ENABLED=false
# Hosted LangSmith is not needed. The workflow explicitly disables hosted tracing.
LANGSMITH_TRACING=false
