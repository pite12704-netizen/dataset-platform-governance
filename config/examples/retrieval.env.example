# Public template only. Never fill this file with real secrets and commit it.
# Service settings (when using compose.retrieval.yml, URL/enabled/secret paths are injected).
DP_RETRIEVAL_ENABLED=false
DP_RETRIEVAL_TEXT_MODEL=bge-m3-local-v1
DP_RETRIEVAL_IMAGE_MODEL=chinese-clip-local-v1
DP_RETRIEVAL_TEXT_DIMENSIONS=1024
DP_RETRIEVAL_IMAGE_DIMENSIONS=512
DP_RETRIEVAL_RERANK_ENABLED=false
DP_RETRIEVAL_LEXICAL_MODE=bm25
DP_RETRIEVAL_BM25_MAX_ENTRIES=5000
DP_RETRIEVAL_BM25_MAX_BYTES=16777216
DP_RETRIEVAL_INDEX_BATCH=8
DP_RETRIEVAL_TIMEOUT_SECONDS=15
# On Windows place these external paths on the data disk, outside the repository.
# Compose variables (supply your reviewed image digests / model paths / secret paths):
# DP_QDRANT_IMAGE=
# DP_ENCODER_IMAGE=
# DP_RETRIEVAL_DATA_ROOT=
# DP_TEXT_MODEL_DIR=
# DP_IMAGE_MODEL_DIR=
# DP_QDRANT_KEY_FILE=
# DP_ENCODER_KEY_FILE=
