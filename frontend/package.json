{
  "name": "dataset-platform-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:uploads": "node --test tests/uploads.test.mjs",
    "test:directories": "node --test tests/directory-import.test.mjs",
    "test:navigation": "node --test tests/directory-navigation.test.mjs",
    "test:tasks": "node --test tests/task-polling.test.mjs",
    "test:agent": "node --test tests/agent-request.test.mjs tests/agent-progress.test.mjs",
    "test:previews": "node --test tests/previews.test.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node --test --test-concurrency=1 tests/agent-context.test.mjs tests/agent-workflow.test.mjs tests/review-template.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.24.0",
    "hash-wasm": "^4.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.4.5"
  },
  "license": "MIT"
}
