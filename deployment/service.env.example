DP_ENVIRONMENT=production
DP_DEPLOYMENT=private
DP_SECRET_KEY_FILE=/run/secrets/app_key
DP_SESSION_SIGNING_KEY_FILE=/run/secrets/session_signing_key
DP_MFA_ENCRYPTION_KEYS_FILE=/run/secrets/mfa_encryption_keys
DP_DATABASE_URL_FILE=/run/secrets/database_url
DP_STORAGE_BACKEND=s3
DP_S3_ENDPOINT=http://minio:9000
DP_S3_BUCKET=datasets
DP_S3_ACCESS_KEY_FILE=/run/secrets/s3_access_key
DP_S3_SECRET_KEY_FILE=/run/secrets/s3_secret_key
DP_REDIS_URL_FILE=/run/secrets/redis_url
DP_TASK_MODE=celery
DP_DATABASE_POOL_SIZE=10
DP_DATABASE_MAX_OVERFLOW=10
DP_DATABASE_POOL_TIMEOUT=5
DP_DATABASE_CONNECT_TIMEOUT=10
DP_DATABASE_READ_TIMEOUT=30
DP_DATABASE_WRITE_TIMEOUT=30
DP_DATABASE_ASYNC_POOL_SIZE=5
DP_DATABASE_ASYNC_MAX_OVERFLOW=0
DP_API_THREAD_TOKENS=40
DP_REQUEST_BODY_TIMEOUT_SECONDS=30
DP_UPLOAD_RECEIVE_TIMEOUT_SECONDS=120
DP_UPLOAD_MAX_INFLIGHT=8
DP_DOWNLOAD_MAX_INFLIGHT=8
DP_MEDIA_MAX_INFLIGHT=4
DP_MCP_MAX_INFLIGHT=4
DP_AGENT_TERMINAL_TIMEOUT_SECONDS=5
DP_S3_MAX_POOL_CONNECTIONS=40
DP_MCP_JWKS_TIMEOUT_SECONDS=3
DP_MCP_JWKS_CACHE_SECONDS=300
DP_SCAN_MODE=clamav
DP_CLAMAV_HOST=clamav
DP_MALWARE_MAX_BYTES=67108864
DP_PUBLIC_URL=https://localhost:8443
DP_FRONTEND_URL=https://localhost:8443
DP_CORS_ORIGINS=["https://localhost:8443"]
DP_COOKIE_SECURE=true
DP_REQUIRE_ADMIN_MFA=true
DP_REQUIRE_VERIFICATION=true
# deployment：公网默认开放、私有默认关闭；closed：始终关闭；open：显式开放。
DP_REGISTRATION_MODE=deployment
# 私有本地账号由管理员创建，无需邮箱。私有自行注册若不验证邮箱，需显式配置 REQUIRE_VERIFICATION=false。
# SMTP 配置后才开放网页邮箱找回；密码通过密钥文件提供，不能写入源码。
# DP_SMTP_HOST=smtp.your-company.example
# DP_SMTP_PORT=587
# DP_SMTP_STARTTLS=true
# DP_SMTP_SSL=false
# DP_MAIL_FROM=datasets@your-company.example
# DP_SMTP_USERNAME=service-account
# DP_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# SSL 465 使用 SMTP_SSL=true、SMTP_STARTTLS=false；企业 CA 可指定 DP_SMTP_CA_FILE。
DP_MODEL_URL=http://host.docker.internal:1234/v1
DP_MODEL_NAME=image-pilot-qwen3-vl-4b
DP_VISION_ENABLED=false
DP_REVIEW_LEASE_SECONDS=300
# 有效账号的上传、分片和导入进度单独计费；登录/普通 API 的防滥用额度保留。
DP_TRANSFER_LIMIT_PER_MINUTE=1200
# 模型须通过工具调用评测后启用；不会赋予模型写权限。
DP_AGENT_TOOLS_ENABLED=false
DP_AGENT_PROTOCOL=native
# 经迁移后可选 langgraph：固定业务图的持久化暂停/恢复，与模型自主工具开关独立。
DP_AGENT_WORKFLOW_ENGINE=legacy
DP_AGENT_GRAPH_LEASE_SECONDS=120
DP_AGENT_GRAPH_MAX_PENDING=20
DP_AGENT_MAX_ROUNDS=4
DP_AGENT_MAX_TOOL_CALLS=6
DP_AGENT_TIMEOUT_SECONDS=45
DP_AGENT_CONTEXT_BYTES=32768
DP_AGENT_TOTAL_TOKENS=12000

# 对话轮数与单次工具执行轮数独立；历史逐条按当前授权重查。
DP_AGENT_HISTORY_TURNS=6
DP_AGENT_HISTORY_BYTES=8192
# 宿主机与容器模型 URL 指向同一 GPU 时，使用相同资源组与并发配置。
DP_MODEL_RESOURCE_GROUP=local-inference
DP_MODEL_MAX_INFLIGHT=2
DP_MODEL_QUEUE_SECONDS=2
DP_MODEL_RETRY_ATTEMPTS=2
DP_MODEL_BREAKER_FAILURES=3
DP_MODEL_BREAKER_SECONDS=30
DP_VISION_TIMEOUT_SECONDS=120
# 可分离聊天和视觉服务；权重版本须由部署方核实后填写，空值拒绝正式视觉任务。
DP_VISION_MODEL_URL=
DP_VISION_MODEL_NAME=
DP_VISION_MODEL_REVISION=
DP_GOVERNANCE_MAX_IMAGES=2000
# 质量门槛是发布策略，不是模型准确率承诺。
DP_QUALITY_MIN_TRUTH_IMAGES=100
DP_QUALITY_MIN_POSITIVES=20
DP_QUALITY_MIN_NEGATIVES=20
DP_QUALITY_MIN_PRECISION=0.9
DP_QUALITY_MIN_RECALL=0.8
DP_QUALITY_MIN_ATTRIBUTE_COVERAGE=0.95
