FROM python@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/backend:/app
WORKDIR /app
COPY backend/requirements.lock /app/backend/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r backend/requirements.lock && useradd --uid 10001 --create-home platform
COPY backend /app/backend
COPY clients /app/clients
COPY converter_core.py /app/converter_core.py
COPY scripts/platform_data.py /app/scripts/platform_data.py
COPY scripts/build_fingerprint.py /app/scripts/build_fingerprint.py
COPY deployment/Dockerfile.api /app/deployment/Dockerfile.api
COPY .dockerignore /app/.dockerignore
RUN python scripts/build_fingerprint.py --root /app --output /app/build-info.json
RUN mkdir -p /app/var/mail && chown -R platform:platform /app/var
USER platform
EXPOSE 8000
CMD ["uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--limit-concurrency", "64", "--no-access-log", "--proxy-headers", "--forwarded-allow-ips", "*"]
